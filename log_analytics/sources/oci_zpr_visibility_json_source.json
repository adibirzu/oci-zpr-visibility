{
  "name": "OCI ZPR Visibility JSON",
  "description": "Custom JSON source for OCI ZPR posture, policy, protected resource, flow-review, drift, coverage, and collection-health evidence.",
  "parser": "json",
  "timestampField": "event_time",
  "recordTypes": [
    "zpr_policy_statement",
    "zpr_resource",
    "zpr_finding",
    "zpr_enriched_flow",
    "zpr_policy_drift",
    "zpr_coverage",
    "zpr_collection_gap",
    "zpr_run"
  ],
  "fields": [
    "schema_version",
    "run_id",
    "record_type",
    "event_time",
    "inventory_snapshot_time",
    "snapshot_time",
    "policy_id",
    "policy_name",
    "policy_lifecycle_state",
    "statement",
    "statement_hash",
    "source_attribute",
    "destination_attribute",
    "source_type",
    "destination_type",
    "source_cidrs",
    "destination_cidrs",
    "source_ips",
    "destination_ips",
    "network_scope",
    "target_type",
    "resource_id",
    "resource_name",
    "resource_type",
    "private_ip",
    "security_attributes",
    "severity",
    "finding_type",
    "classification",
    "review_classification",
    "correlation_confidence",
    "correlation_reason",
    "evidence_source",
    "zpr_attribution",
    "action",
    "source_ip",
    "destination_ip",
    "destination_port",
    "protocol",
    "zpr_destination",
    "matched_expected_policy",
    "matched_policy_id",
    "matched_policy_name",
    "flow_id",
    "bytes_out",
    "packets",
    "capture_status",
    "change_type",
    "old_statement",
    "new_statement",
    "collection_status",
    "flow_collection_status",
    "coverage_status",
    "collection_service",
    "collection_operation",
    "error_category"
  ]
}
